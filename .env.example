# Bloom GCC Corporate Growth Engine — environment variables.
# Copy to .env.local. NEVER commit real keys. Every variable is optional:
# the app runs fully in local demo mode with none of them set.

# Optional: enables Claude-assisted outreach drafting (server-side only).
# Without it, drafts come from the built-in deterministic templates.
ANTHROPIC_API_KEY=
# Optional model override (defaults to claude-opus-5).
ANTHROPIC_MODEL=

# Reserved for the Supabase adapter (see docs/ROADMAP.md). Not used yet.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
